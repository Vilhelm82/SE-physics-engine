  delta = 2 - gamma^2; F(r0) = 0; g = E^T q E = -dt^2 + dr^2 + r^2 dOmega^2 EXACTLY
  g(K,K) = -F, g(K,J) = 1, g(J,J) = 0; at r0: K = d_t + d_r, NULL -- the seat dies in Minkowski
